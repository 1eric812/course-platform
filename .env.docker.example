# ============================================================
# 高校选课平台 - Docker Compose 环境变量模板
# 使用方法：复制为 .env 后修改
# ============================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change_me_please
MYSQL_PORT=3306

# ---- 后端 / 前端 ----
BACKEND_PORT=8080

# ---- JWT 签名密钥 ----
# 长度必须 ≥ 32 字节，生产环境务必改掉默认值
JWT_SECRET=please-change-this-to-a-random-string-at-least-32-bytes
